    handlePromptCompilation(request.payload)
      .then((optimizedResult) => {
        sendResponse({ optimizedPrompt: optimizedResult });
      })
      .catch((error) => {
        console.error('Compilation error:', error);
        sendResponse({ optimizedPrompt: request.payload }); // Fallback to raw text
      });

    return true; // Required for async sendResponse in MV3
  }
});

