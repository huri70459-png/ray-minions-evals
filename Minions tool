2. Configuring manifest.json (Manifest V3)
Your manifest needs host permissions for target web platforms (e.g., ChatGPT, Claude) and declaration of your content scripts.

JSON
{
  "manifest_version": 3,
  "name": "Enterprise Prompt Copilot",
  "version": "1.0.0",
  "description": "Tier-1 cognitive compilation and skill injection middleware for LLM platforms.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.css"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"]
    }
  ]
}
3. The Content Script (content.js) & Shadow DOM Isolation
The content script is responsible for two main things:

Injecting an isolated Shadow DOM container into the host page so platform styles (like ChatGPT's Tailwind classes) don't break your UI.

Listening globally for the Cmd + K (Mac) or Ctrl + K (Windows) shortcut to pop open your overlay.

JavaScript
// content.js - Injected into target platforms

(function () {
  'use strict';

  // Prevent double injection
  if (document.getElementById('enterprise-copilot-root')) return;

  // 1. Create a host container element
  const hostDiv = document.createElement('div');
  hostDiv.id = 'enterprise-copilot-root';
  document.body.appendChild(hostDiv);

  // 2. Attach a Shadow DOM (Crucial for style isolation)
  const shadowRoot = hostDiv.attachShadow({ mode: 'open' });

  // 3. Inject scoped styles inside the shadow root
  const styleLink = document.createElement('link');
  styleLink.rel = 'stylesheet';
  styleLink.href = chrome.runtime.getURL('inject.css');
  shadowRoot.appendChild(styleLink);

  // 4. Create the UI wrapper element
  const container = document.createElement('div');
  container.id = 'copilot-modal-container';
  container.innerHTML = `
    <div id="copilot-backdrop" style="display: none;">
      <div id="copilot-palette">
        <div class="copilot-header">
          <span>⚡ Enterprise Prompt Copilot</span>
          <span class="copilot-esc">Esc</span>
        </div>
        <textarea id="copilot-input" placeholder="Type or paste your rough prompt here..."></textarea>
        <div id="copilot-telemetry">
          <span class="pill">🧩 Matched Skills: None</span>
          <span class="pill">🤖 Model: Claude 3.5 Sonnet</span>
        </div>
        <div class="copilot-footer">
          <button id="copilot-execute">Execute & Inject ↵</button>
        </div>
      </div>
    </div>
  `;
  shadowRoot.appendChild(container);

  // UI Elements mapping
  const backdrop = shadowRoot.getElementById('copilot-backdrop');
  const inputArea = shadowRoot.getElementById('copilot-input');
  const executeBtn = shadowRoot.getElementById('copilot-execute');

  // 5. Global Keyboard Listener (Cmd+K / Ctrl+K)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      togglePalette(true);
    }
    // Close on Escape
    if (e.key === 'Escape' && backdrop.style.display === 'flex') {
      togglePalette(false);
    }
  });

  function togglePalette(show) {
    if (show) {
      backdrop.style.display = 'flex';
      inputArea.focus();
      // Capture text from active host text box if available
      const activeTextarea = document.querySelector('textarea');
      if (activeTextarea && activeTextarea.value) {
        inputArea.value = activeTextarea.value;
      }
    } else {
      backdrop.style.display = 'none';
      inputArea.value = '';
    }
  }

  // Backdrop click to close
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) togglePalette(false);
  });

  // 6. Handle Execution & Hand-off
  executeBtn.addEventListener('click', async () => {
    const rawPrompt = inputArea.value;
    if (!rawPrompt.trim()) return;

    // Send payload to background service worker for compilation & routing
    chrome.runtime.sendMessage({ action: 'COMPILE_AND_OPTIMIZE', payload: rawPrompt }, (response) => {
      if (response && response.optimizedPrompt) {
        injectIntoHostPlatform(response.optimizedPrompt);
        togglePalette(false);
      }
    });
  });

  function injectIntoHostPlatform(finalPrompt) {
    // Locate the native chat platform's input box (e.g., ChatGPT or Claude textarea)
    const hostTextarea = document.querySelector('textarea');
    if (hostTextarea) {
      // Set value using native property setter to trigger framework state changes (React/Vue)
      const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, "value").set;
      nativeInputValueSetter.call(hostTextarea, finalPrompt);
      
      hostTextarea.dispatchEvent(new Event('input', { bubbles: true }));
      hostTextarea.dispatchEvent(new Event('change', { bubbles: true }));

      // Optional: auto-submit or leave ready for user review
      // hostTextarea.form.querySelector('button[type="submit"]')?.click();
    }
  }
})();
4. Background Service Worker (background.js)
In Manifest V3, background scripts are persistent event-driven service workers. It handles secure communication with your backend compilation engine or runs local heuristics.

