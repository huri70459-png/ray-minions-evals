D. Compiling the LangGraph Workflow (app/workflow/graph.py)
Wires the nodes into a stateful DAG with conditional routing loops.

Python
from langgraph.graph import StateGraph, START, END
from app.workflow.state import CopilotGraphState
from app.workflow.nodes import (
    intent_dissection_node,
    prompt_optimizer_node,
    coder_agent_node,
    security_auditor_node,
    doc_writer_agent_node,
    should_retry_security
)

def build_copilot_graph():
    workflow = StateGraph(CopilotGraphState)

    # 1. Add Nodes
    workflow.add_node("intent_dissection", intent_dissection_node)
    workflow.add_node("prompt_optimizer", prompt_optimizer_node)
    workflow.add_node("coder_agent", coder_agent_node)
    workflow.add_node("security_auditor", security_auditor_node)
    workflow.add_node("doc_writer", doc_writer_agent_node)

    # 2. Define Linear Edges
    workflow.add_edge(START, "intent_dissection")
    workflow.add_edge("intent_dissection", "prompt_optimizer")
    workflow.add_edge("prompt_optimizer", "coder_agent")
    workflow.add_edge("coder_agent", "security_auditor")

    # 3. Conditional Edge for Self-Healing Loop
    workflow.add_conditional_edges(
        "security_auditor",
        should_retry_security,
        {
            "retry_coder": "coder_agent",        # Loop back to fix code
            "proceed_to_docs": "doc_writer"      # Move forward to documentation
        }
    )

    workflow.add_edge("doc_writer", END)

    return workflow.compile()

# Singleton compiled graph instance
compiled_copilot_graph = build_copilot_graph()
