from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from app.schemas import CompileRequest, CompileResponse
from app.workflow.graph import compiled_copilot_graph

app = FastAPI(
    title="Enterprise Prompt Copilot Middleware API",
    version="1.0.0",
    description="Cognitive compilation and multi-agent workflow engine."
)

# Enable CORS for extension communication
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # Restrict to extension ID in production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.post("/v1/compile", response_model=CompileResponse)
async def compile_prompt(request: CompileRequest):
    try:
        # Initial graph state payload
        initial_state = {
            "raw_prompt": request.raw_prompt,
            "intent": None,
            "matched_skills": [],
            "optimized_prompt": None,
            "generated_code": None,
            "security_audit_result": None,
            "documentation": None,
            "retry_count": 0,
            "final_output": None
        }

        # Run the LangGraph execution flow asynchronously
        final_state = await compiled_copilot_graph.ainvoke(initial_state)

        return CompileResponse(
            status="SUCCESS",
            optimized_prompt=final_state.get("final_output", request.raw_prompt),
            matched_skills=final_state.get("matched_skills", []),
            audit_report=final_state.get("security_audit_result")
        )

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
