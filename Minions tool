from pydantic import BaseModel, Field
from typing import Optional, Dict, Any

class CompileRequest(BaseModel):
    raw_prompt: str = Field(..., description="The rough prompt captured from the client UI")
    target_platform: str = Field("chatgpt", description="Destination platform e.g. chatgpt, claude, hermes")
    user_metadata: Optional[Dict[str, Any]] = Field(default_factory=dict)

class CompileResponse(BaseModel):
    status: str
    optimized_prompt: str
    matched_skills: list[str]
    audit_report: Optional[Dict[str, Any]] = None
